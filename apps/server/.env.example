# Copy to apps/server/.env (never commit it). All values are optional in development.

# Port the Colyseus server listens on (hosting platforms usually set PORT for you).
PORT=2567

# Comma-separated list of website origins allowed to connect, e.g.
#   CLIENT_ORIGINS=https://highway-rush.vercel.app,https://highway-rush.pages.dev
# Leave EMPTY only for local development: an empty list accepts ANY origin.
CLIENT_ORIGINS=http://localhost:5173

# Seconds between "everyone is ready" and the race loading.
LOBBY_COUNTDOWN_SECONDS=3
# Max seconds to wait for every client to finish loading before starting anyway.
LOAD_TIMEOUT_SECONDS=15
# How long a dropped rider's seat is held (AI drives meanwhile).
RECONNECT_WINDOW_RACE_SECONDS=25
# After the first rider finishes, others get this long before results are final.
FINISH_GRACE_SECONDS=30
# Hard cap on race length.
MAX_RACE_SECONDS=600

# Supabase (Phase 5 - progression). Server-side only; NEVER expose the service-role key to the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
