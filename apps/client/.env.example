# Copy to .env.local. Only VITE_* variables are exposed to the browser.
# Never put secrets (e.g. Supabase service-role key) in client env files.

# Colyseus server URL. Use wss:// in production (https sites cannot open plain ws://).
# If unset in dev, the client uses ws://<page host>:2567.
VITE_SERVER_URL=ws://localhost:2567

# Supabase public (anon) credentials (used from Phase 5 - progression)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
